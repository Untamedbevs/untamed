# Copy to .env.local and fill in existing Untamed development credentials.
# Blank values are intentionally unconfigured. Never commit .env.local.
# NEXT_PUBLIC_* values are shipped to the browser: never put secrets in them.

# Core: required for portal/admin and database-backed routes.
# Use the exact PUBLIC_API_KEY name expected by this repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Unset in production means https://untamedbeverages.com; set it locally so links point here.
NEXT_PUBLIC_SITE_URL=http://localhost:3003

# Media uploads, generated assets, and downloads.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
MEDIA_CDN_URL=
# Blank keeps public assets local. Only set after the assets exist on the CDN.
NEXT_PUBLIC_SITE_ASSET_BASE_URL=
STATIC_ASSET_S3_PREFIX=site-assets

# Studio: Fal generates media; AI Gateway powers campaign planning.
FAL_KEY=
AI_GATEWAY_API_KEY=
# Short-lived alternative to AI_GATEWAY_API_KEY; refresh via Vercel CLI.
VERCEL_OIDC_TOKEN=
NEXT_PUBLIC_STUDIO_GENERATE_STAGGER_MS=0
NEXT_PUBLIC_FLOWS_PARALLEL_FLOWS=

# Google Workspace email. Do not send test messages to customers.
GOOGLE_SMTP_USER=
GOOGLE_SMTP_APP_PASSWORD=
GOOGLE_SMTP_HOST=smtp-relay.gmail.com
GOOGLE_SMTP_PORT=587
SMTP_FROM_EMAIL=
# Legacy fallback for SMTP_FROM_EMAIL.
SES_FROM_EMAIL=

# Email system (see docs/email/README.md). Marketing only sends when every
# "required for marketing" value is set; the admin blast page lists what's missing.
# Transactional transport: smtp (Google Workspace) until SES is verified, then ses.
EMAIL_TRANSPORT=smtp
# Marketing transport: ses. smtp is refused unless EMAIL_ALLOW_SMTP_MARKETING=true.
EMAIL_MARKETING_TRANSPORT=ses
EMAIL_ALLOW_SMTP_MARKETING=
# SES region; defaults to AWS_REGION. Optional dedicated keys, else AWS_* keys are used.
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Required for marketing: configuration set names and the SNS topic ARN(s) the
# webhook accepts. scripts/aws/ses/setup-ses.mjs prints these.
SES_CONFIGURATION_SET_MARKETING=
SES_CONFIGURATION_SET_TRANSACTIONAL=
SES_SNS_TOPIC_ARNS=
# Required for marketing (CAN-SPAM): full street address or registered PO box.
EMAIL_POSTAL_ADDRESS=
# Comma-separated ISO country codes allowed to receive marketing; * allows any.
EMAIL_MARKETING_COUNTRIES=US
# Warm-up cap on marketing emails per UTC day; blank = no cap.
EMAIL_MARKETING_DAILY_CAP=
EMAIL_SEND_RATE_PER_SECOND=10
# Set to the versions in src/lib/email/consent-copy.ts once counsel approves them.
EMAIL_REPERMISSION_APPROVED_VERSION=
EMAIL_CHECKOUT_CONSENT_APPROVED_VERSION=
# Where system alerts (complaint spikes, failed sends) are emailed; comma-separated.
EMAIL_ALERT_RECIPIENTS=
# Signup form bot protection (Cloudflare Turnstile). Optional: without it the
# forms rely on a honeypot field and rate limits.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Gmail sync and one-to-one outreach: a Google Workspace service account with
# domain-wide delegation (see docs/email/gmail-and-outreach.md).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Staff mailboxes whose conversations with known contacts are logged; comma-separated.
GMAIL_SYNC_MAILBOXES=
# Mailbox whose incoming "unsubscribe" emails are processed automatically.
GMAIL_UNSUBSCRIBE_MAILBOX=unsubscribe@untamedbeverages.com
GMAIL_SYNC_LOOKBACK_DAYS=14

# Meta ads, Conversions API, and organic publishing.
META_ACCESS_TOKEN=
META_CAPI_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_PAGE_ACCESS_TOKEN=
META_FB_PAGE_ID=
META_IG_USER_ID=
META_TEST_EVENT_CODE=

# Optional browser analytics. Leave blank to avoid local tracking.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# Server-side AccelPay order reconciliation and signed webhooks.
ACCELPAY_API_TOKEN=
ACCELPAY_WEBHOOK_SECRET=
ACCELPAY_API_BASE=https://api.accelpay.io
ACCELPAY_BRAND_ID=5008728

# Background jobs, internal operations, and UGC processing.
# Generate independent random local secrets; deployed peers need matching values.
CRON_SECRET=
CE_OPS_SECRET=
UGC_LAMBDA_WEBHOOK_SECRET=
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

# Deployment/script-only settings. APP_BASE_URL belongs on the AWS Lambda.
# Localhost cannot receive external webhooks without a reachable tunnel.
APP_BASE_URL=
WEBHOOK_BASE_URL=
# Legacy fallback used by CRM blast links; NEXT_PUBLIC_SITE_URL takes priority.
SITE_URL=

# Optional administrative connection string, supplied separately; unused by the app.
Postgres_Link=
